{
  "name": "explainer-studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:backend": "convex dev",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "node scripts/build-web.mjs",
    "build:worker": "esbuild workers/media/index.ts scripts/render-fixture.ts scripts/render-project.ts scripts/verify-repair.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outdir=dist",
    "worker": "node --env-file-if-exists=.env.worker dist/workers/media/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run assets:verify && npm run typecheck && npm run lint && npm test && npm run build",
    "assets:import": "node scripts/import-lesson-assets.mjs",
    "assets:verify": "node scripts/verify-lesson-assets.mjs",
    "deploy": "npx @convex-dev/static-hosting deploy --dist out --build-command \"npm run build:web\"",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "render:fixture": "node dist/scripts/render-fixture.js",
    "render:project": "node dist/scripts/render-project.js",
    "providers:setup": "node scripts/setup-providers.mjs",
    "review:setup": "node scripts/setup-review.mjs",
    "delivery:setup": "node scripts/setup-delivery.mjs",
    "openai:setup": "node scripts/setup-openai.mjs",
    "repair:verify": "node --env-file-if-exists=.env dist/scripts/verify-repair.js"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workflow": "0.4.6",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@remotion/bundler": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "@xmldom/xmldom": "0.9.12",
    "convex": "1.45.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.520",
    "svix": "2.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "convex-test": "0.0.56",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
