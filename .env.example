# Frontend: public deployment URL only. The Convex CLI writes .env.local.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Worker: set matching WORKER_AUTH_TOKEN in Convex and Zerops.
CONVEX_SITE_URL=
WORKER_AUTH_TOKEN=
WORKER_ID=mediaworker-1
PORT=3001

# Configure these SERVER-SIDE in Convex; never prefix them NEXT_PUBLIC_.
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FIRECRAWL_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# Provider setup reads the four H2 values above from .env and qualifies them.
# npm run providers:setup (development); npm run providers:setup -- --prod (production).
# GENERATION_ENABLED is controlled server-side by the setup script.
# H3: npm run review:setup copies the existing Cloudflare review credentials to development and keeps generation disabled.
# Use -- --prod for production. It sends no email and does not qualify real review quality.
# Email setup is separate: npm run delivery:setup (add -- --prod for production).
# Register AgentMail events message.sent/message.delivered/message.bounced at
# https://YOUR-DEPLOYMENT.convex.site/api/webhooks/agentmail and use its signing secret.
