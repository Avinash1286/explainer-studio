# Frontend: public deployment URL only. The Convex CLI writes .env.local.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Worker: set matching WORKER_AUTH_TOKEN in Convex and Zerops.
CONVEX_SITE_URL=
WORKER_AUTH_TOKEN=
WORKER_ID=mediaworker-1
PORT=3001

# Configure these SERVER-SIDE in Convex; never prefix them NEXT_PUBLIC_.
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
